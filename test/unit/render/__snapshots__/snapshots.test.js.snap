exports[`Render-Pipeline-Snapshots (Viewer-Pfad) > rendert spoiler.md stabil 1`] = `
"<p data-source-line="1">Achtung <span class="spoiler" tabindex="0">geheimer Text</span> im Satz.</p>
<p data-source-line="3">Mit Markup: <span class="spoiler" tabindex="0">hier <strong>fett</strong> und <em>kursiv</em> verborgen</span>.</p>
<p data-source-line="5">Escape bleibt Text: ||kein Spoiler|| im Satz.</p>
<p data-source-line="7">Spoiler-Versuch in einer Pipe-Tabellen-Zelle (unescapte Pipes trennen
Zellen, GFM verwirft die überzähligen):</p>
<table data-source-line="10">
<thead data-source-line="10">
<tr data-source-line="10">
<th>Spalte A</th>
<th>Spalte B</th>
<th>C</th>
<th>D</th>
</tr>
</thead>
<tbody data-source-line="12">
<tr data-source-line="12">
<td>a</td>
<td></td>
<td>sp</td>
<td></td>
</tr>
</tbody>
</table>
<p data-source-line="14">Mit escapten Pipes bleibt die Zeile vierzellig und der Spoiler
funktioniert in der Zelle:</p>
<table data-source-line="17">
<thead data-source-line="17">
<tr data-source-line="17">
<th>Spalte A</th>
<th>Spalte B</th>
<th>C</th>
<th>D</th>
</tr>
</thead>
<tbody data-source-line="19">
<tr data-source-line="19">
<td>a <span class="spoiler" tabindex="0">sp</span> b</td>
<td>x</td>
<td>y</td>
<td>z</td>
</tr>
</tbody>
</table>
<p data-source-line="21">Einzelne Pipe | bleibt Text; <a href="Ziel.md" class="wikilink">Label</a> bleibt Wiki-Link.</p>
"
`;

exports[`Render-Pipeline-Snapshots (Viewer-Pfad) > rendert sub-sup-ins.md stabil 1`] = `
"<p data-source-line="1">Chemie: H<sub>2</sub>O und CO<sub>2</sub> im Fließtext.</p>
<p data-source-line="3">Mathematik: x<sup>2</sup> und e<sup>iπ</sup> hochgestellt.</p>
<p data-source-line="5">Unterstrichen: <ins>wichtiger Hinweis</ins> im Satz.</p>
<p data-source-line="7">Kombination: <strong>fett mit H<sub>2</sub>O</strong> und <sup><strong>fettes</strong> hoch</sup> gemischt.</p>
<p data-source-line="9">Gegenproben:</p>
<p data-source-line="11"><s>durchgestrichen</s> bleibt Strikethrough, H<sub>2</sub>O bleibt tiefgestellt.</p>
<p data-source-line="13">Fußnote<sup class="footnote-ref"><a href="#fn1" id="fnref1">[1]</a></sup> und Inline-Fußnote<sup class="footnote-ref"><a href="#fn2" id="fnref2">[2]</a></sup> bleiben Fußnoten.</p>
<p data-source-line="17" id="anker1">Absatz mit Block-Anker bleibt Anker.</p>
<p data-source-line="19">C++ und D++ lösen kein Underline aus; C+±Code und C+±Stil ebenfalls nicht.</p>
<p data-source-line="21">Einzelzeichen bleiben Text: 2^10 und a~b im Fließtext.</p>
<p data-source-line="23">Kein Whitespace-Inhalt: ~x y~ bleibt Text, ++ x ++ ebenfalls.</p>
<p data-source-line="25">Escapes: ^^kein Sup^^ und ++kein Ins++ und ~kein Sub~ bleiben Text.</p>
<hr class="footnotes-sep">
<section class="footnotes">
<ol class="footnotes-list">
<li id="fn1" class="footnote-item"><p data-source-line="15">Definition der Fußnote. <a href="#fnref1" class="footnote-backref">↩︎</a></p>
</li>
<li id="fn2" class="footnote-item"><p>Direkt definiert <a href="#fnref2" class="footnote-backref">↩︎</a></p>
</li>
</ol>
</section>
"
`;

