exports[`Render-Pipeline-Snapshots (Viewer-Pfad) > rendert columns.md stabil 1`] = `
"<div class="md-columns md-columns-2"><p data-source-line="2">Erste Spalte: der Text fließt automatisch über die Spalten. <strong>Markdown</strong> bleibt aktiv.</p>
<ul data-source-line="4">
<li data-source-line="4">Punkt eins</li>
<li data-source-line="5">Punkt zwei</li>
</ul>
<div class="md-column-break"></div>
<p data-source-line="9">Zweite Spalte: hier durch den Umbruch-Marker begonnen.</p>
</div><div class="md-columns md-columns-5"><p data-source-line="13">Fünf Spalten sind das Maximum.</p>
</div><div class="custom-container container-columns"><p data-source-line="17">Eine Spalte ist ungültig und fällt auf die neutrale Box zurück.</p>
</div><div class="custom-container container-columns"><p data-source-line="21">Sechs Spalten sind ungültig (Rückfall).</p>
</div><div class="custom-container container-columns"><p data-source-line="25">Fehlende Zahl fällt zurück.</p>
</div><div class="custom-container container-columns"><p data-source-line="29">Nicht-numerische Angabe fällt zurück.</p>
</div><p data-source-line="32">Ein Umbruch-Marker außerhalb eines Spalten-Blocks:</p>
<div class="md-column-break"></div>
<p data-source-line="36">ist wirkungslos, erzeugt aber ein neutrales Marker-Element.</p>
"
`;

