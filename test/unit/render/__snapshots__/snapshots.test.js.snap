exports[`Render-Pipeline-Snapshots (Viewer-Pfad) > rendert emoji.md stabil 1`] = `
"<p data-source-line="1">Ein Lächeln 😄 und ein Herz ❤️ im Fließtext.</p>
<p data-source-line="3">Alias-Formen: 👍 und 👎 sowie 👍.</p>
<p data-source-line="5">Unbekannter Shortcode bleibt Text: :keinemoji: und :so_etwas_gibt_es_nicht:.</p>
<p data-source-line="7">Uhrzeit 10:30:45 bleibt unverändert, ebenso die URL <a href="https://example.org/pfad">https://example.org/pfad</a>.</p>
<p data-source-line="9">Emoticons werden nicht umgewandelt: :) und 8-) bleiben Klartext.</p>
<p data-source-line="11">Im Code-Kontext bleibt <code>:smile:</code> roh.</p>
<p data-source-line="13">Direkt hintereinander: 😄👍 ohne Trenner.</p>
"
`;

