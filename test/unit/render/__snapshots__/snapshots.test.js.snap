</td><td>2026-02-01</td><td>fantasie</td><td>Ende vor Beginn</td><td><span style="font-size: 0.85em; white-space: nowrap;"><span style="opacity: 0.7;">vergangen</span><br>136 Tage<br>19 Wochen, 3 Tage<br>4 Monate, 2 Wochen, 0 Tage</span></td></tr></tbody></table>
