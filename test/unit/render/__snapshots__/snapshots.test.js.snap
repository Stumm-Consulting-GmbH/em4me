exports[`Render-Pipeline-Snapshots (Viewer-Pfad) > rendert perspective-query.md stabil 1`] = `
"<h1 id="frontmatter-abfrage-perspective-query" data-source-line="1">Frontmatter-Abfrage (perspective-query)</h1>
<p data-source-line="3">Einfache Wert-Abfrage:</p>
<div class="perspective-query" data-fm-query="bereich = &quot;Privat&quot;"></div>
<p data-source-line="9">Boolescher Ausdruck mit Klammern, IN, NOT IN und NOT:</p>
<div class="perspective-query" data-fm-query="(bereich = &quot;Privat&quot; AND tags IN (&quot;rot&quot;, &quot;rund&quot;)) OR NOT status = &quot;erledigt&quot;"></div>
<p data-source-line="15">Mehrzeiliger Body mit Ungleichheit und NOT IN:</p>
<div class="perspective-query" data-fm-query="bereich != &quot;Archiv&quot;
AND tags NOT IN (&quot;intern&quot;, &quot;entwurf&quot;)"></div>
<p data-source-line="22">Ein Syntaxfehler bleibt ebenfalls ein Platzhalter (die Auswertung erfolgt erst im Renderer):</p>
<div class="perspective-query" data-fm-query="bereich ="></div>
<p data-source-line="28">Klausel-Form mit Tabellen-Ausgabe, Quellen, Sortierung und Limit:</p>
<div class="perspective-query" data-fm-query="TABLE status AS &quot;Status&quot;, file.mtime
FROM &quot;Projekte&quot; AND #aktiv
WHERE file.mtime &gt;= date(today) - dur(30 days)
SORT file.mtime DESC, file.name
LIMIT 20"></div>
<p data-source-line="38">Mehrspaltige Ergebnis-Liste:</p>
<div class="perspective-query" data-fm-query="LIST FROM #lesezeichen COLUMNS 3"></div>
<p data-source-line="44">Block-Ebene (Scope-Zusatz BLOCKS, 3E-0077):</p>
<div class="perspective-query" data-fm-query="LIST BLOCKS WHERE status = &quot;offen&quot; SORT updated DESC"></div>
<div class="perspective-query" data-fm-query="TABLE BLOCKS status AS &quot;Status&quot;, updated
FROM &quot;Projekte&quot;
WHERE prio &gt; 2"></div>
"
`;

