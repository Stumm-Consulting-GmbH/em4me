exports[`Render-Pipeline-Snapshots (Viewer-Pfad) > rendert critic-markup.md stabil 1`] = `
"<p data-source-line="1">Addition: A <ins class="critic">eingefügt</ins> B.</p>
<p data-source-line="3">Deletion: A <del class="critic">gelöscht</del> B.</p>
<p data-source-line="5">Substitution: A <del class="critic">alt</del><ins class="critic">neu</ins> B.</p>
<p data-source-line="7">Highlight: A <mark class="critic">hervorgehoben</mark> B.</p>
<p data-source-line="9">Kommentar: A <span class="critic-comment">Anmerkung des Reviewers</span> B.</p>
<p data-source-line="11">Koexistenz: <mark class="critic">Critic-Highlight</mark> neben <mark>normalem Highlight</mark>.</p>
<p data-source-line="13">Strikethrough-Koexistenz: <del class="critic">a</del><ins class="critic">b</ins> neben <s>durchgestrichen</s>.</p>
<p data-source-line="15">Substitution ohne Pfeil bleibt roh: {<s>nur alt</s>} im Satz.</p>
<p data-source-line="17">Mehrzeilig bleibt unkonsumiert (die Plus-Plus-Spanne selbst greift als Insertion):</p>
<p data-source-line="19">{<ins>zeile eins
zeile zwei</ins>}</p>
<p data-source-line="22">Escape: {<ins>kein Critic</ins>} bleibt mit Klammer-Rest.</p>
"
`;

