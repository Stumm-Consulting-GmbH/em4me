# Dependencies
node_modules/

# Generated renderer assets (created by the build scripts from node_modules;
# see scripts/build-renderer.js and its helpers)
src/renderer/renderer.bundle.js
src/renderer/hljs-themes.css
src/renderer/katex/
src/renderer/mermaid.bundle.js

# Generated chart library build and its license texts (created by
# scripts/build-echarts.js before every start, test and build)
src/shared/charts/echarts.bundle.js
src/shared/charts/echarts.LICENSES.txt

# Generated language catalogues (assembled from src/i18n/fragments/ by
# scripts/build-i18n.js before every start, test and build)
src/i18n/*.json

# Build output
dist/
out/
*.exe
*.msi
*.appx

# Version archive (filled by the postbuild hook, see scripts/archive-build.js)
releases/

# Playwright artifacts
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*

# Editor / OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local configuration
.env
.env.local

# Electron user data (when testing via a local symlink)
userData/
